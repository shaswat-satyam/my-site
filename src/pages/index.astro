---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, NAME, MAIL, COMPANY, ROLE, CURRENT_TECH, LOCATION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Hello, There! 👋 </h1>
			<p>
				This is <b>{NAME}</b>. Currently, I am a working as a <b>{ROLE}</b> at <b>{COMPANY}</b>. I work with <b>{CURRENT_TECH}</b> at my current role at an enterprise level. I am based in <b>{LOCATION}</b>.
			</p>
			<p>
				I am interested in various stuff like <b>Open Source, Rust, Linux and Nix. </b> If Any thing interests you or collaborate, Please feel free to contact me via <a href=`mailto:${MAIL}`>mail</a> or any socials.
			</p>
			<p>
			<a target="_blank" href="/public/ResumeNovember.pdf">My Resume</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
