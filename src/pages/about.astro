import { Image } from 'astro:assets';

import  bluesky_svg  from '../assets/svgs/bluesky.svg';
import  bookwyrm_svg  from '../assets/svgs/bookwyrm.svg';
import  code_katas_svg  from '../assets/svgs/code-katas.svg';
import  dev_svg  from '../assets/svgs/dev.svg';
import  github_svg  from '../assets/svgs/github.svg';
import  hackerrank_svg  from '../assets/svgs/hackerrank.svg';
import  jerboa_svg  from '../assets/svgs/jerboa.svg';
